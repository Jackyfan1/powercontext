# ScholarLens 环境配置
# 复制此文件为 .env 并填入真实值

# PowerContext 本地服务地址（真实 PowerContext Server）
POWERCONTEXT_URL=http://127.0.0.1:8710

# LLM 配置（可选，不配置则使用摘录式回答）
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Embedding 模型（首次运行自动下载）
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 数据库路径
DATABASE_PATH=./data/scholarlens.db

# 服务端口
SERVER_PORT=8000
