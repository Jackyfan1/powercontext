# seekdb 连接
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=memory_bar

# HTTP 服务端口（Dify 的 HTTP 节点需要访问这个端口）
SERVER_PORT=8787

# 向量模型：默认自动下载 Xenova/bge-small-zh-v1.5 的 ONNX 权重（约 24 MB）
EMBEDDING_MODEL_REPO=Xenova/bge-small-zh-v1.5
VECTOR_DIM=512

# 国内网络可取消注释，改用 Hugging Face 镜像
# HF_ENDPOINT=https://hf-mirror.com
